MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=garage301
JWT_SECRET=garaje301-cambia-esta-clave
PORT=3001

# En Railway estas las crea el plugin MySQL al conectar el servicio:
# MYSQLHOST MYSQLPORT MYSQLUSER MYSQLPASSWORD MYSQLDATABASE
# Además define JWT_SECRET (una frase larga y secreta).

# URL pública (enlace de reagendar en WhatsApp). En Render suele bastar RENDER_EXTERNAL_URL.
# APP_URL=https://tu-sitio.onrender.com

# WhatsApp de citas (elige UNA opción). Sin esto, al agendar se abre wa.me;
# el aviso de 1 hora y el de “no llegó” sí necesitan una de estas APIs.

# Meta Cloud API (Business):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Ultramsg:
# ULTRAMSG_TOKEN=
# ULTRAMSG_INSTANCE=instanceXXXX

# CallMeBot (un número de prueba):
# CALLMEBOT_APIKEY=
